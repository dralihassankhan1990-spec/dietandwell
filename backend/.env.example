# DietAndWell backend — copy to .env and fill in real values. NEVER commit .env.
# See README.md at the project root for setup and deployment.

# ---- Server ----
PORT=8000
NODE_ENV=development
# Public URL of the frontend that may call this API (comma-separated list also accepted).
# The production domains are always allowed in addition to this value.
FRONTEND_URL=http://localhost:3100

# ---- Database (pick ONE style) ----
# Option A (preferred on Railway / Neon / hosted Postgres): a single URL.
# When set, DATABASE_URL takes precedence over the DATABASE_* parts below.
# DATABASE_URL=postgresql://user:pass@host:5432/dietandwell
# Set to "true" only if your Postgres requires TLS (Railway/Neon do).
DATABASE_SSL=false
# Option B (local dev): individual parts.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=dietandwell
# Optional troubleshooting only. SQL parameters may contain sensitive data.
DATABASE_LOGGING=false

# ---- Auth ----
# REQUIRED. Minimum 32 random characters. The server refuses to boot without it.
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=change-me-to-a-different-random-string-at-least-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# ---- Email (Resend) — OPTIONAL ----
# When RESEND_API_KEY is unset, contact-form email sending is a graceful
# no-op (logged) and the form still saves to the DB and returns success.
RESEND_API_KEY=
FROM_EMAIL=noreply@dietandwell.com
# Where contact-form notifications go. Defaults to ADMIN_EMAIL when unset.
CONTACT_EMAIL=

# ---- Admin seed (npm run seed) ----
# ADMIN_EMAIL defaults to admin@dietandwell.com.
ADMIN_EMAIL=admin@dietandwell.com
# REQUIRED for seeding. The seed script fails with a clear error if missing.
# Never commit a real value here — set it in the shell when running the seed.
ADMIN_PASSWORD=

# ---- Image uploads (Cloudinary) — OPTIONAL ----
# When all three are set, uploads are stored on Cloudinary and the local
# file is deleted. When any is missing, uploads stay on local disk under
# backend/public/uploads and nothing fails.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Online payments (JazzCash / Easypaisa) — OPTIONAL ----
# Both providers are currently STUBS: their service methods return HTTP 501
# until a developer implements them with real credentials.
# See JAZZCASH_EASYPAISA_GUIDE.md at the project root for setup steps.
# JazzCash
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_SECURE_HASH=
JAZZCASH_RETURN_URL=
JAZZCASH_TRANSACTION_URL=
JAZZCASH_SANDBOX=true
# Easypaisa
EASYPaisa_STORE_ID=
EASYPaisa_HASH_KEY=
EASYPaisa_MERCHANT_ACCOUNT=
EASYPaisa_RETURN_URL=
EASYPaisa_API_URL=
EASYPaisa_SANDBOX=true
